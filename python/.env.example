# Copy this file to .env and put your own values after the = signs.
# .env stays on your machine: Git ignores it. This file is shared.

# Your Claude API key, from the API keys page of the Claude Console.
ANTHROPIC_API_KEY=

# Your OpenAI API key, from the API keys page of the OpenAI Platform:
# askkit transcribe, --moderate, and askkit answer with gpt-6-luna.
OPENAI_API_KEY=

# Your Gemini API key, from Google AI Studio: askkit answer with
# gemini-3.5-flash-lite. A key of a project with no billing uses Google's
# unpaid terms, under which Google may train on what you send.
GEMINI_API_KEY=
